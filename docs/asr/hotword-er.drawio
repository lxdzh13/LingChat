<mxfile host="app.diagrams.net" agent="LingChat" version="24.0.0">
<diagram name="ASR 热词 ER" id="asr-hotword-er">
<mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="role" value="&lt;table width=&#x27;100%&#x27; cellpadding=&#x27;4&#x27; cellspacing=&#x27;0&#x27; style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;border-collapse:collapse;&#x27;&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#334155;color:#fff;font-weight:bold;font-size:14px;padding:8px 10px;&#x27;&gt;role（既有）&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#ffffff;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;id&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#f8fafc;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;name&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;TEXT&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#f1f5f9;color:#475569;font-size:10.5px;padding:6px 10px;&#x27;&gt;既有角色表；删角色由应用层清理&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="hotword" value="&lt;table width=&#x27;100%&#x27; cellpadding=&#x27;4&#x27; cellspacing=&#x27;0&#x27; style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;border-collapse:collapse;&#x27;&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#1e3a5f;color:#fff;font-weight:bold;font-size:14px;padding:8px 10px;&#x27;&gt;hotword&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#ffffff;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;id&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;PK, AUTOINCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#f8fafc;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;scope&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;TEXT&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NOT NULL: role / global / library&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#ffffff;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;role_id&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NULL；scope=&amp;#x27;role&amp;#x27; 时必填&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#f8fafc;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;category_id&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NULL；scope=&amp;#x27;library&amp;#x27; 时可空&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#ffffff;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;text&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;TEXT&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NOT NULL；trim 后非空&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#f8fafc;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;weight&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NOT NULL DEFAULT 4；1..5 或 50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#f1f5f9;color:#475569;font-size:10.5px;padding:6px 10px;&#x27;&gt;无 FK：role_id / category_id 的逻辑归属由应用层清理&lt;br&gt;scope 三值把运行时热词和词库素材放在同一张物理表里&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e3a5f;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="520" height="330" as="geometry"/></mxCell>
<mxCell id="category" value="&lt;table width=&#x27;100%&#x27; cellpadding=&#x27;4&#x27; cellspacing=&#x27;0&#x27; style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;border-collapse:collapse;&#x27;&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#6b21a8;color:#fff;font-weight:bold;font-size:14px;padding:8px 10px;&#x27;&gt;hotword_category&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#ffffff;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;id&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;INTEGER&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;PK, AUTOINCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#x27;background:#f8fafc;&#x27;&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;font-weight:bold;&#x27;&gt;name&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;font-family:Consolas,monospace;color:#0f766e;&#x27;&gt;TEXT&lt;/td&gt;&lt;td style=&#x27;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px;&#x27;&gt;NOT NULL；≤30 字符&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&#x27;3&#x27; style=&#x27;background:#f1f5f9;color:#475569;font-size:10.5px;padding:6px 10px;&#x27;&gt;UNIQUE(name)；分类名 1..30 字符&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b21a8;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="edge-role" value="1 : 0..*  role_id（仅 scope=&#x27;role&#x27;）" style="endArrow=block;html=1;rounded=0;strokeColor=#64748b;strokeWidth=2;fontSize=11;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="role" target="hotword"><mxGeometry x="0" y="0" width="0" height="0" as="geometry"/></mxCell>
<mxCell id="edge-cat" value="0..* : 1  category_id（仅 scope=&#x27;library&#x27;）" style="endArrow=block;html=1;rounded=0;strokeColor=#64748b;strokeWidth=2;fontSize=11;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="hotword" target="category"><mxGeometry x="0" y="0" width="0" height="0" as="geometry"/></mxCell>
<mxCell id="scope-note" value="&lt;div style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;color:#334155;&#x27;&gt;&lt;div style=&#x27;background:#0f766e;color:#fff;font-weight:bold;padding:6px 10px;font-size:14px;&#x27;&gt;scope 语义与唯一键&lt;/div&gt;&lt;div style=&#x27;padding:10px 12px;&#x27;&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;scope       role_id       category_id    参与 ASR&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;role        NOT NULL      NULL           是&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;global      NULL          NULL           是&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;library     NULL          NULL / NOT NULL 否（素材）&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;唯一键：&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;  role    → (role_id, text)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;  global  → (text)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;  library → (category_id, text)，未分类单独按 text 唯一&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;全局词与未分类词库词的空值形态相同，必须靠 scope 区分。&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="650" height="300" as="geometry"/></mxCell>
<mxCell id="migration-note" value="&lt;div style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;color:#334155;&#x27;&gt;&lt;div style=&#x27;background:#2563eb;color:#fff;font-weight:bold;padding:6px 10px;font-size:14px;&#x27;&gt;迁移与 LAN 兼容&lt;/div&gt;&lt;div style=&#x27;padding:10px 12px;&#x27;&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;up：重建分类表补 CHECK；三张旧表按 scope 汇入 hotword，保留组内 id 顺序&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;down：按 scope 拆回三张旧表，可逆；旧约束由新约束保证成立&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;LAN：过渡版本双写 hotwords + legacy 数组；新端优先读 hotwords&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;旧端继续读 role/global/library 三个数组，避免一次升级断同步&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="650" height="190" as="geometry"/></mxCell>
<mxCell id="constraints" value="&lt;div style=&#x27;font-family:Microsoft YaHei,Segoe UI,sans-serif;font-size:12px;color:#334155;&#x27;&gt;&lt;div style=&#x27;background:#b45309;color:#fff;font-weight:bold;padding:6px 10px;font-size:14px;&#x27;&gt;约束与索引（DDL 层）&lt;/div&gt;&lt;div style=&#x27;padding:10px 12px;&#x27;&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;§ CHECK&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;scope IN (&amp;#x27;role&amp;#x27;,&amp;#x27;global&amp;#x27;,&amp;#x27;library&amp;#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;(scope=&amp;#x27;role&amp;#x27;    AND role_id IS NOT NULL AND category_id IS NULL)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;OR (scope=&amp;#x27;global&amp;#x27;  AND role_id IS NULL     AND category_id IS NULL)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;OR (scope=&amp;#x27;library&amp;#x27; AND role_id IS NULL)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;weight IN (1, 2, 3, 4, 5, 50)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;length(trim(text, char(9)||char(10)||char(13)||&amp;#x27; &amp;#x27;)) &amp;gt; 0&lt;/div&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;§ 唯一索引（partial unique）&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;ux_hotword_role_text (role_id, text) WHERE scope=&amp;#x27;role&amp;#x27;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;ux_hotword_global_text (text) WHERE scope=&amp;#x27;global&amp;#x27;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;ux_hotword_library_category_text (category_id, text)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;    WHERE scope=&amp;#x27;library&amp;#x27; AND category_id IS NOT NULL&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;ux_hotword_library_uncategorized_text (text)&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;    WHERE scope=&amp;#x27;library&amp;#x27; AND category_id IS NULL&lt;/div&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;§ 查询索引&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;ix_hotword_scope_id (scope, id)&lt;/div&gt;&lt;div style=&#x27;color:#92400e;font-weight:bold;margin-top:6px;&#x27;&gt;不放进 DDL 的部分&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;文本长度 15 字符 / 7 片段的双分支判据留在应用层；&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;SQLite CHECK 无法准确复刻 Rust split_whitespace 的语义。&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#334155;line-height:1.55;&#x27;&gt;role_id=0（User）仍允许入库，不额外加 role_id &amp;gt; 0。&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#b45309;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="740" height="500" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>